[Unit]
Description=PrintUpkeep connector
Documentation=https://github.com/online-concept-aps/printupkeep-os
Wants=network-online.target
After=network-online.target printupkeep-firstboot.service

[Service]
Type=simple
User=printupkeep
Group=printupkeep
# --web-port 80: the connector's local web UI (flag lands with the web UI work
# in the connector; already wired here so the image is ready for it).
ExecStart=/usr/local/bin/node /opt/printupkeep/current/dist/cli.js --config /var/lib/printupkeep/connector.json --web-port 80
WorkingDirectory=/var/lib/printupkeep
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=80
Environment=LOG_LEVEL=info

# Binding port 80 as an unprivileged user
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/printupkeep

[Install]
WantedBy=multi-user.target
