# The printupkeep service user may only: restart its own service, kick off a
# connector self-update, and read its own service logs. Nothing else.
printupkeep ALL=(root) NOPASSWD: /usr/bin/systemctl restart printupkeep-connector, /usr/bin/systemctl start printupkeep-update.service, /usr/bin/journalctl -u printupkeep-connector *
