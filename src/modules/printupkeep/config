#!/bin/bash
###############################################################################
# All our config settings must start with PRINTUPKEEP_

# Node.js runtime baked into the image (official nodejs.org arm64 build).
# Pin the latest 22.x release; the sha256 is for node-v<ver>-linux-arm64.tar.xz
# from https://nodejs.org/dist/v<ver>/SHASUMS256.txt
[ -n "$PRINTUPKEEP_NODE_VERSION" ] || PRINTUPKEEP_NODE_VERSION=22.23.2
[ -n "$PRINTUPKEEP_NODE_SHA256" ] || PRINTUPKEEP_NODE_SHA256=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

# Connector release baked into the image. The CI workflow downloads
# printupkeep-connector-<version>.tgz (+ .tgz.sha256) from the GitHub release
# tagged connector-v<version> on this repo into filesystem/connector/ BEFORE
# the CustomPiOS build, so the chroot script installs from a local file and
# needs no network or GitHub credentials inside the chroot.
[ -n "$PRINTUPKEEP_CONNECTOR_VERSION" ] || PRINTUPKEEP_CONNECTOR_VERSION=0.1.0
